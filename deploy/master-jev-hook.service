# Template for the Master-JEV Hook gateway service (systemd --user).
# To install: replace @REPO@ (absolute checkout path) and @NODE@ (absolute node >= 22.15) and copy
# to ~/.config/systemd/user/. See the README, gateway service section.
[Unit]
Description=Master-JEV Hook gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO@/gateway
ExecStart=@NODE@ --env-file=%h/.config/master-jev-hook/gateway.env @REPO@/gateway/dist/index.js
StandardOutput=append:%h/.local/state/master-jev-hook/router.log
StandardError=journal
Restart=on-failure
RestartSec=5
UMask=0077
# Sandbox: the gateway only reads its checkout and env file; the one place it may write is the
# state folder (JEV_LOG_FILE lives there, and so must JEV_DEBUG_DUMP_DIR if you enable it).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/state/master-jev-hook
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
