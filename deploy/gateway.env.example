# Master-JEV Hook gateway. Copy to ~/.config/master-jev-hook/gateway.env with chmod 600.
# Do not use `source`; node reads it with --env-file. Never commit the real file.
TYPESAFE_API_KEY=
HOST=127.0.0.1
PORT=8795
JEV_CLIENT=hook
JEV_MODEL=jev-1.13.0
JEV_MIN_CONFIDENCE=0.65
# Optional (gateway defaults): JEV_MIN_CONFIDENCE_MEDIUM=0.80, JEV_MIN_CONFIDENCE_HIGH=0.90,
# JEV_MAX_RETRIES=2, JEV_RETRY_BASE_MS=500
JEV_DIRECT_CALLS=false
JEV_CONTEXT_ROUTING=true
JEV_INSPECT_INPUTS=false
# Only to expose the gateway beyond loopback (HOST other than 127.0.0.1/localhost/::1, which is
# refused without it): clients then send "Authorization: Bearer <ROUTER_API_KEY>", which the MCP
# server and hooks read from MASTER_JEV_GATEWAY_KEY. Requires UPSTREAM_API_KEY.
# ROUTER_API_KEY=
# UPSTREAM_API_KEY=
# Absolute path (no ~ or $HOME); persists the dashboard's history across restarts.
JEV_LOG_FILE=/ABSOLUTE/PATH/.local/state/master-jev-hook/router.log
