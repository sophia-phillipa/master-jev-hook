# Gateway Master-JEV Hook. Copiar para ~/.config/master-jev-hook/gateway.env com chmod 600.
# Não usar `source`; o node lê com --env-file. Nunca versionar o arquivo real.
TYPESAFE_API_KEY=
HOST=127.0.0.1
PORT=8795
JEV_CLIENT=hook
JEV_MODEL=jev-1.13.0
JEV_MIN_CONFIDENCE=0.65
# Opcionais (padrões do gateway): JEV_MIN_CONFIDENCE_MEDIUM=0.80, JEV_MIN_CONFIDENCE_HIGH=0.90,
# JEV_MAX_RETRIES=2, JEV_RETRY_BASE_MS=500
JEV_DIRECT_CALLS=false
JEV_CONTEXT_ROUTING=true
JEV_INSPECT_INPUTS=false
# Caminho absoluto (sem ~ nem $HOME); persiste o histórico do painel entre reinícios.
JEV_LOG_FILE=/CAMINHO/ABSOLUTO/.local/state/master-jev-hook/router.log
