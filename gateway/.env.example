# =============================================================================
# Essencial: o que o gateway usa para atender as ferramentas MCP e os hooks
# (solicitar_decisao, jev_classificar, jev_verificar, jev_pontuar, jev_ranquear).
# A seção "Proxy opcional", no fim, só importa para quem usa os lançadores
# gateway/bin/master-jev-*.
# =============================================================================

# --- Chave do JEV (obrigatória) ---------------------------------------------
# Defina UMA das três. Com mais de uma, JEV_PROVIDER escolhe (padrão: a
# primeira presente).
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# JEV_PROVIDER=typesafe   # typesafe | openrouter | vercel

# --- Servidor ---------------------------------------------------------------
PORT=8795
# Mantenha loopback. Para outras máquinas acessarem, defina também ROUTER_API_KEY.
HOST=127.0.0.1

# --- JEV ---------------------------------------------------------------------
# Padrão: o modelo do próprio provedor (jev-latest na TypeSafe).
# JEV_MODEL=
JEV_TIMEOUT_MS=8000
# JEV_MAX_RETRIES=2
# JEV_RETRY_BASE_MS=500
# Confiança mínima para aceitar a resposta do JEV, por risco da decisão
# (baixo, médio, alto). Abaixo dela o resultado é abstenção.
JEV_MIN_CONFIDENCE=0.65
# JEV_MIN_CONFIDENCE_MEDIUM=0.80
# JEV_MIN_CONFIDENCE_HIGH=0.90

# --- Painel e log (GET /dashboard) -------------------------------------------
# Rótulo do tráfego deste gateway no painel.
JEV_CLIENT=hook
# Arquivo JSON Lines para onde vai o stdout do gateway (ex.: `pnpm start >> router.log`).
# É lido na partida, para o histórico do painel sobreviver a reinícios.
JEV_LOG_FILE=
# Mostra no painel as entradas enviadas ao JEV. Texto livre pode conter dados privados.
JEV_INSPECT_INPUTS=false

# =============================================================================
# Proxy opcional: só para quem roteia o tráfego de LLM de um cliente (Codex,
# Claude Code, Gemini, OpenCode) por este gateway com os lançadores
# master-jev-codex, master-jev-claude, master-jev-gemini e master-jev-opencode
# (que gravam a chave em ~/.master-jev-hook/.env). Quem só usa o MCP e os
# hooks pode ignorar esta seção.
# =============================================================================

# --- LLM de destino (qualquer API compatível com OpenAI) ---------------------
UPSTREAM_BASE_URL=https://api.openai.com/v1
# Se definida, substitui o Authorization do cliente nas chamadas ao destino;
# senão, o Authorization do cliente é repassado como veio.
UPSTREAM_API_KEY=
# Se definida, os clientes precisam enviar "Authorization: Bearer <ROUTER_API_KEY>"
# (exige UPSTREAM_API_KEY).
ROUTER_API_KEY=
# Modelo mais barato usado só para preencher argumentos depois que o JEV escolhe a ferramenta.
ARGS_MODEL=

# --- Roteamento de ferramentas ------------------------------------------------
# off faz o gateway atuar só como proxy com medição (base para comparar tokens).
# Pode ser trocado em tempo de execução pelo painel ou com `master-jev-codex --routing on|off`.
JEV_ROUTING=on
JEV_CONTEXT_ROUTING=true
# Certeza mínima por argumento de conjunto fechado para responder sem o LLM.
JEV_ARG_MIN_CERTAINTY=0.8
# Quando o JEV diz "nenhuma ferramenta": force_none (tool_choice=none) | passthrough
JEV_ON_NONE=force_none
# Responde direto (sem chamar o LLM) quando todo argumento é enum/booleano.
JEV_DIRECT_CALLS=false
JEV_MAX_STATE_CHARS=60000
JEV_MAX_MESSAGE_CHARS=4000
# Grava em disco cada requisição roteada, com credenciais ocultas. Contém a conversa inteira.
JEV_DEBUG_DUMP_DIR=
