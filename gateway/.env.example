# =============================================================================
# Essential: what the gateway uses to serve the MCP tools and hooks
# (request_decision, jev_classify, jev_verify, jev_score, jev_rank).
# The "Optional proxy" section, at the end, only matters for those using the
# gateway/bin/master-jev-* launchers.
# =============================================================================

# --- JEV key (required) -----------------------------------------------------
# Set ONE of the three. With more than one, JEV_PROVIDER picks (default: the
# first one present).
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# JEV_PROVIDER=typesafe   # typesafe | openrouter | vercel

# --- Server -------------------------------------------------------------------
PORT=8795
# Keep loopback. For other machines to access it, also set ROUTER_API_KEY.
HOST=127.0.0.1

# --- JEV ------------------------------------------------------------------------
# Default: the provider's own model (jev-latest on TypeSafe).
# JEV_MODEL=
JEV_TIMEOUT_MS=8000
# JEV_MAX_RETRIES=2
# JEV_RETRY_BASE_MS=500
# Minimum confidence to accept the JEV's response, by decision risk
# (low, medium, high). Below it the result is an abstention.
JEV_MIN_CONFIDENCE=0.65
# JEV_MIN_CONFIDENCE_MEDIUM=0.80
# JEV_MIN_CONFIDENCE_HIGH=0.90

# --- Dashboard and log (GET /dashboard) ---------------------------------------
# Label for this gateway's traffic on the dashboard.
JEV_CLIENT=hook
# JSON Lines file the gateway's stdout is written to (e.g. `pnpm start >> router.log`).
# It is read on startup, so the dashboard's history survives restarts.
JEV_LOG_FILE=
# Shows on the dashboard the entries sent to the JEV. Free text may contain private data.
JEV_INSPECT_INPUTS=false

# =============================================================================
# Optional proxy: only for those routing an LLM client's traffic (Codex,
# Claude Code, Gemini, OpenCode) through this gateway with the
# master-jev-codex, master-jev-claude, master-jev-gemini and master-jev-opencode
# launchers (which write the key to ~/.master-jev-hook/.env). Those who only
# use the MCP server and the hooks can ignore this section.
# =============================================================================

# --- Destination LLM (any OpenAI-compatible API) -------------------------------
UPSTREAM_BASE_URL=https://api.openai.com/v1
# If set, replaces the client's Authorization on calls to the destination;
# otherwise, the client's Authorization is forwarded as-is.
UPSTREAM_API_KEY=
# If set, clients must send "Authorization: Bearer <ROUTER_API_KEY>"
# (requires UPSTREAM_API_KEY).
ROUTER_API_KEY=
# Cheaper model used only to fill in arguments after the JEV picks the tool.
ARGS_MODEL=

# --- Tool routing ----------------------------------------------------------------
# off makes the gateway act only as a proxy with measurement (baseline for comparing tokens).
# Can be toggled at runtime from the dashboard or with `master-jev-codex --routing on|off`.
JEV_ROUTING=on
JEV_CONTEXT_ROUTING=true
# Minimum certainty per closed-set argument to answer without the LLM.
JEV_ARG_MIN_CERTAINTY=0.8
# When the JEV says "no tool": force_none (tool_choice=none) | passthrough
JEV_ON_NONE=force_none
# Answers directly (without calling the LLM) when every argument is enum/boolean.
JEV_DIRECT_CALLS=false
JEV_MAX_STATE_CHARS=60000
JEV_MAX_MESSAGE_CHARS=4000
# Writes each routed request to disk, with credentials hidden. Contains the entire conversation.
JEV_DEBUG_DUMP_DIR=
